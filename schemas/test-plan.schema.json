{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpf-ai-automation.local/schemas/test-plan.schema.json",
  "title": "WPF AI Automation Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testId", "applicationKey", "steps"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "testId": { "$ref": "#/$defs/nonEmptyString" },
    "applicationKey": { "$ref": "#/$defs/nonEmptyString" },
    "testData": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 4096 },
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/setText" },
          { "$ref": "#/$defs/invoke" },
          { "$ref": "#/$defs/selectItem" },
          { "$ref": "#/$defs/readElement" },
          { "$ref": "#/$defs/waitFor" },
          { "$ref": "#/$defs/assert" },
          { "$ref": "#/$defs/captureScreenshot" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "stepNumber": { "type": "integer", "minimum": 1 },
    "controlType": { "enum": ["unknown", "button", "checkBox", "comboBox", "edit", "list", "listItem", "text", "window"] },
    "property": { "enum": ["exists", "name", "value", "enabled", "visible"] },
    "operator": { "enum": ["exists", "notExists", "equals", "notEquals", "contains", "notEmpty", "enabled", "visible"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automationId"],
      "properties": {
        "automationId": { "$ref": "#/$defs/nonEmptyString" },
        "controlType": { "$ref": "#/$defs/controlType" },
        "ancestorAutomationId": { "$ref": "#/$defs/nonEmptyString" },
        "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
      }
    },
    "baseStep": {
      "type": "object",
      "required": ["action", "stepNumber"],
      "properties": {
        "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
      }
    },
    "setText": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "stepNumber", "target", "value"],
          "properties": {
            "action": { "const": "setText" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
            "target": { "$ref": "#/$defs/target" }, "value": { "type": "string", "maxLength": 4096 },
            "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
          }
        }
      ]
    },
    "invoke": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "stepNumber", "target"],
      "properties": {
        "action": { "const": "invoke" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "target": { "$ref": "#/$defs/target" }, "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
      }
    },
    "selectItem": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "stepNumber", "target", "itemAutomationId"],
      "properties": {
        "action": { "const": "selectItem" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "target": { "$ref": "#/$defs/target" }, "itemAutomationId": { "$ref": "#/$defs/nonEmptyString" },
        "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
      }
    },
    "readElement": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "stepNumber", "target", "property"],
      "properties": {
        "action": { "const": "readElement" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "target": { "$ref": "#/$defs/target" }, "property": { "$ref": "#/$defs/property" },
        "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
      }
    },
    "waitFor": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "stepNumber", "target", "condition"],
      "properties": {
        "action": { "const": "waitFor" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "target": { "$ref": "#/$defs/target" },
        "condition": {
          "type": "object", "additionalProperties": false,
          "required": ["property", "operator"],
          "properties": {
            "property": { "$ref": "#/$defs/property" }, "operator": { "$ref": "#/$defs/operator" },
            "expectedValue": { "type": ["string", "null"], "maxLength": 4096 },
            "pollIntervalMilliseconds": { "type": "integer", "minimum": 25, "maximum": 5000 },
            "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
          }
        }
      }
    },
    "assert": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "stepNumber", "target", "property", "operator"],
      "properties": {
        "action": { "const": "assert" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "target": { "$ref": "#/$defs/target" }, "property": { "$ref": "#/$defs/property" },
        "operator": { "$ref": "#/$defs/operator" }, "expectedValue": { "type": ["string", "null"], "maxLength": 4096 },
        "timeoutMilliseconds": { "$ref": "#/$defs/timeout" }
      }
    },
    "captureScreenshot": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "stepNumber", "name"],
      "properties": {
        "action": { "const": "captureScreenshot" }, "stepNumber": { "$ref": "#/$defs/stepNumber" },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
