{
  "applications": {
    "patient-demo": {
      "executablePath": "C:\\path\\to\\PatientDemo.exe",
      "processName": "PatientDemo",
      "allowedArguments": [],
      "startupTimeoutCeilingMilliseconds": 30000,
      "versionProbe": null
    }
  },
  "policy": {
    "maximumStepCount": 100,
    "maximumStringLength": 4096,
    "maximumTimeoutMilliseconds": 60000,
